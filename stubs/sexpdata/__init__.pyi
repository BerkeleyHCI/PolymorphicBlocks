"""Typed surface used by PB for sexpdata 1.x; parsed trees are heterogeneous."""

from typing import Any

class String(str):
    def value(self) -> str: ...
    @classmethod
    def quote(cls, string: str) -> str: ...
    @classmethod
    def unquote(cls, string: str) -> str: ...

class Symbol(String): ...

def loads(string: str, **kwds: Any) -> Any: ...
def dumps(obj: Any, **kwds: Any) -> str: ...
